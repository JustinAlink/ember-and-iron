	quest.05BA8DD11AF6102A.quest_desc: ["You beat the hardest fights, built the biggest machines and mastered the arcane. Not bad."]
	quest.05BA8DD11AF6102A.title: "Ember & Iron"
	quest.06FEA72836736668.quest_desc: ["Haunts the frozen seas on a ghost ship."]
	quest.06FEA72836736668.title: "Captain Cornelia"
	quest.08EB6AB52D1080BA.title: "Shafts and cogs"
	quest.0946F4F609D5699F.quest_desc: ["Handcrafted, Macaw's and Supplementaries add furniture, windows, roofs, bridges, lights and a lot more decoration."]
	quest.0946F4F609D5699F.title: "Make it home"
	quest.0C0E477377052575.quest_desc: ["Inferium ore drops essence; plant seeds made from it to farm resources."]
	quest.0C0E477377052575.quest_subtitle: "Mystical Agriculture"
	quest.0C0E477377052575.title: "Grow your resources"
	quest.0C4375173AD4B4B7.title: "Inscription table"
	quest.0D2682C64C1FBE9A.quest_desc: ["Not required for anything except the Otherside's key. Bring a plan and an exit."]
